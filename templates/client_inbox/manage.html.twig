{% extends 'base.html.twig' %}
{% block title %}Caixas de clientes - Mail4u{% endblock %}

{% block body %}
<section class="mail4u-home">
    <div class="mail4u-home-layout">
        {% for message in app.flashes('error') %}
            <p class="notification is-danger">{{ message }}</p>
        {% endfor %}
        {% if error is defined %}
            <p class="notification is-danger">{{ error }}</p>
        {% endif %}
        {% for credentials in app.flashes('client_inbox_credentials') %}
            {% set link = path('app_client_inbox', {uuid: credentials.uuid}) %}
            <section class="box g4-card mail4u-result">
                <h2 class="title is-5">Caixa criada</h2>
                <dl>
                    <div>
                        <dt>E-mail</dt>
                        <dd>{{ credentials.email }}</dd>
                        <dd><button type="button" class="button is-small" data-copy="{{ credentials.email }}">Copiar e-mail</button></dd>
                    </div>
                    <div>
                        <dt>Senha da caixa</dt>
                        <dd><code>{{ credentials.password }}</code></dd>
                        <dd><button type="button" class="button is-small" data-copy="{{ credentials.password }}">Copiar senha</button></dd>
                    </div>
                    <div>
                        <dt>Link de acesso</dt>
                        <dd><a data-client-inbox-link href="{{ link }}">{{ link }}</a></dd>
                        <dd><button type="button" class="button is-small" data-copy-link>Copiar link</button></dd>
                    </div>
                </dl>
                <p class="mt-4">Guarde a senha agora. Ela só é exibida nesta tela após a criação.</p>
                {% if credentials.expiresAt is defined %}
                    <p>Recebe mensagens até {{ credentials.expiresAt }}.</p>
                {% endif %}
                <div class="buttons mt-4">
                    <button type="button" class="button" data-copy="{{ 'E-mail: ' ~ credentials.email ~ "\nSenha: " ~ credentials.password ~ "\nLink: " ~ url('app_client_inbox', {uuid: credentials.uuid}) }}">Copiar dados de acesso</button>
                    <a class="button is-primary" href="{{ link }}">Abrir caixa</a>
                </div>
            </section>
        {% endfor %}
        {% if canCreate %}
        <form method="post" class="box g4-card mail4u-create-form">
            <h1 class="title">Nova caixa de e-mail</h1>
            <p class="mb-5">Informe o nome do cliente. A caixa recebe mensagens por um ano.</p>

            <input type="hidden" name="_token" value="{{ csrf_token('create-client-inbox') }}">
            <div class="mail4u-create-fields">
                <div class="field">
                    <label class="label" for="first_name">Nome</label>
                    <input class="input" id="first_name" name="first_name" maxlength="80" required>
                </div>
                <div class="field">
                    <label class="label" for="last_name">Sobrenome</label>
                    <input class="input" id="last_name" name="last_name" maxlength="80" required>
                </div>
            </div>
            <div class="mail4u-create-actions">
                <button class="button is-primary">Criar caixa de e-mail</button>
                <a href="{{ path('app_team_inboxes') }}">Minhas caixas</a>
            </div>
        </form>
        {% else %}
        <section class="box g4-card">
            <h1 class="title">Caixas de e-mail da equipe</h1>
            <p>Entre com sua conta corporativa para criar caixas e gerenciar seus acessos.</p>
            <div class="buttons mt-4">
                <a class="button is-primary" href="{{ path('app_login') }}">Entrar</a>
                <a class="button" href="{{ path('app_team_register') }}">Criar conta</a>
            </div>
            <a href="{{ path('app_client_inbox_login') }}">Acessar uma caixa com e-mail e senha</a>
        </section>
        {% endif %}
    </div>
</section>
<script>
    document.querySelectorAll('[data-client-inbox-link]').forEach((link) => {
        link.textContent = link.href;
        link.closest('.mail4u-result').querySelector('[data-copy-link]').dataset.copy = link.href;
    });
</script>
<script src="/brand/mail4u-inbox.js?v=3" defer></script>
{% endblock %}
