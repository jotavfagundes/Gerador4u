{% extends 'base.html.twig' %}
{% block title %}Acessar caixa de e-mail - Mail4u{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/brand/mail4u-workspace.css">
{% endblock %}

{% block body %}
<section class="section g4-main{% if unlocked %} mailbox-workspace{% endif %}">
    <div class="container">
        {% if not unlocked %}<h1 class="title">Caixa de entrada</h1>{% endif %}
        {% if not unlocked %}
            <form method="post" class="box" style="max-width: 30rem">
                <input type="hidden" name="_token" value="{{ csrf_token('client-inbox-' ~ box.uuid) }}">
                {% if error is defined %}
                    <p class="notification is-danger">{{ error }}</p>
                {% endif %}
                <div class="field">
                    <label class="label" for="password">Senha da caixa</label>
                    <input class="input" type="password" id="password" name="password" maxlength="72" autocomplete="current-password" required>
                </div>
                <button class="button is-primary">Abrir caixa</button>
            </form>
        {% else %}
            <header class="mailbox-header"><div><h1 class="title">Caixa de entrada</h1><p>{{ box.email }}</p></div><a class="button" href="{{ path('app_client_inbox', {uuid: box.uuid}) }}">Atualizar mensagens</a></header>
            {% for notice in app.flashes('success') %}
                <p class="notification is-success is-light">{{ notice }}</p>
            {% endfor %}
            {% for notice in app.flashes('error') %}
                <p class="notification is-danger is-light">{{ notice }}</p>
            {% endfor %}
            <div class="mailbox-layout">
                <aside class="mailbox-sidebar" aria-label="Opções da caixa">
                    <h2>Pastas</h2>
                    <a class="mailbox-folder" href="{{ path('app_client_inbox', {uuid: box.uuid}) }}" aria-current="page">
                        <span aria-hidden="true">✉</span> Caixa de entrada
                    </a>
                    <p class="mailbox-sidebar-label">Configurações da caixa</p>
            <details class="mailbox-settings">
                <summary>Alterar senha da caixa</summary>
                <form method="post" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('client-inbox-' ~ box.uuid) }}">
                    <input type="hidden" name="action" value="change-password">
                    <div class="columns">
                        <div class="column">
                            <label class="label" for="current-password">Senha atual</label>
                            <input class="input" type="password" id="current-password" name="password" maxlength="72" autocomplete="current-password" required>
                        </div>
                        <div class="column">
                            <label class="label" for="new-password">Nova senha</label>
                            <input class="input" type="password" id="new-password" name="new_password" minlength="10" maxlength="64" autocomplete="new-password" required>
                        </div>
                    </div>
                    <button class="button is-primary">Salvar nova senha</button>
                </form>
            </details>
            <p class="mb-4">
                {% if box.expiresAt > date() %}
                    Recebe mensagens até {{ box.expiresAt|date('d/m/Y') }}.
                {% else %}
                    Prazo de recebimento encerrado. As mensagens guardadas continuam disponíveis para consulta.
                {% endif %}

            </p>
            </aside><div class="mailbox-list"><h2>Recebidas <span>{{ emails|length }}</span></h2>
            {% if emails is not empty %}
                <div class="field">
                    <label class="label" for="message-search">Buscar mensagens</label>
                    <input class="input" type="search" id="message-search" placeholder="Assunto ou remetente">
                </div>
                <p id="message-search-empty" hidden>Nenhuma mensagem encontrada.</p>
            {% endif %}
            {% for email in emails %}
                <details class="box mail4u-message" data-message
                         {% if email.readAt is null %}data-unread data-message-id="{{ email.id }}" data-csrf="{{ csrf_token('client-inbox-' ~ box.uuid) }}"{% endif %}>
                    <summary>
                        <span data-message-search><strong>{{ email.fromName ?: (email.fromAddress ?? email.realFrom) }}</strong><span>{{ email.subject ?? '(Sem assunto)' }}</span><small>{{ email.fromAddress ?? email.realFrom }}</small></span>
                        <time>{{ email.createdAt|date('d/m H:i') }}</time>
                        {% if email.readAt is null %}<span class="tag is-light" data-unread-label>Não lida</span>{% endif %}
                    </summary>
                    <div class="mailbox-message-body">
                    <h2 class="title is-5">{{ email.subject ?? '(Sem assunto)' }}</h2>
                    <p>{{ email.fromAddress ?? email.realFrom }} · {{ email.createdAt|date('d/m/Y H:i') }}</p>
                    {% set text = email.metadata.text ?? email.html|default('')|striptags %}
                    {% if 'fast it' in ((email.subject ?? '') ~ ' ' ~ text)|lower or 'fastit' in email.realFrom|lower %}
                        <div data-fast-it="{{ text }}" data-fast-it-subject="{{ email.subject ?? '' }}"></div>
                    {% endif %}
                    <iframe class="mt-3" title="Conteúdo do e-mail" sandbox="allow-popups allow-popups-to-escape-sandbox" style="width: 100%; min-height: 18rem"
                            srcdoc="{{ ('<meta http-equiv="Content-Security-Policy" content="default-src &apos;none&apos;; style-src &apos;unsafe-inline&apos;"><meta name="referrer" content="no-referrer"><base target="_blank">' ~ (email.html ?? ''))|e('html_attr') }}"></iframe>
                    </div>
                </details>
            {% else %}
                <p class="mailbox-list-empty">Nenhuma mensagem</p>
            {% endfor %}</div><div class="mailbox-reader" data-reader><div class="mailbox-placeholder"><span aria-hidden="true">✉</span><h2>{{ emails is empty ? 'Sua caixa está vazia' : 'Selecione uma mensagem' }}</h2><p>{{ emails is empty ? 'Os e-mails recebidos neste endereço aparecerão aqui.' : 'Escolha um e-mail na lista para ler a mensagem.' }}</p></div></div></div>
        {% endif %}
    </div>
</section>
{% if unlocked %}<script src="/brand/mail4u-inbox.js" defer></script>{% endif %}
{% endblock %}
