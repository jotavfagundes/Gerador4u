<header class="g4-header">
    <div class="g4-bar">
        <a href="/" aria-label="Início do Mail4u"><img src="/brand/mail4u-logo-original.png" alt="Mail4u" width="150"></a>
        <nav aria-label="Navegação principal">
            {% set currentRoute = app.request.attributes.get('_route') %}
            <a href="/"{% if currentRoute in ['app_home', 'app_client_inboxes'] %} aria-current="page"{% endif %}>Início</a>
            <a href="{{ path('app_client_inbox_login') }}"{% if currentRoute in ['app_client_inbox_login', 'app_client_inbox'] %} aria-current="page"{% endif %}>Acessar caixa</a>
            {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Administração</a>{% endif %}
            {% if app.user %}
                <a href="{{ path('app_team_inboxes') }}"{% if currentRoute == 'app_team_inboxes' %} aria-current="page"{% endif %}>Minhas caixas</a>
                <a href="{{ path('app_logout') }}">Sair</a>
            {% else %}
                <a href="{{ path('app_login') }}">Entrar</a>
            {% endif %}
        </nav>
    </div>
</header>
