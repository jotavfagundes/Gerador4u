{% extends 'base.html.twig' %}
{% block title %}Criar conta - Mail4u{% endblock %}

{% block body %}
    <section class="section g4-main mail4u-auth">
        <form method="post" class="box g4-card">
            <h1 class="title is-4">Criar conta corporativa</h1>
            <p class="mb-4">Use seu e-mail @cidadania4u.com.br. Você receberá um link para confirmar o endereço e escolher a senha da conta.</p>
            {% if error %}<p class="notification is-danger">{{ error }}</p>{% endif %}
            {% if sent %}
                <p class="notification is-success is-light">Se o endereço estiver disponível para cadastro, você receberá o link de confirmação. Se já tiver uma conta, entre com sua senha.</p>
            {% endif %}
            <input type="hidden" name="_token" value="{{ csrf_token('team-register') }}">
            <div class="field">
                <label class="label" for="team-email">E-mail corporativo</label>
                <input class="input" type="email" name="email" id="team-email" value="{{ email }}" maxlength="180" autocomplete="email" required>
            </div>
            <button class="button is-primary">Enviar confirmação</button>
            <p class="mt-4"><a href="{{ path('app_login') }}">Já tenho conta</a></p>
        </form>
    </section>
{% endblock %}
