{% extends 'base.html.twig' %}
{% block title %}Minhas caixas - Mail4u{% endblock %}

{% block body %}
    <section class="section g4-main">
        <div class="level">
            <div class="level-left"><h1 class="title">Minhas caixas</h1></div>
            <div class="level-right"><a class="button is-primary" href="{{ path('app_home') }}">Criar caixa</a></div>
        </div>
        {% if boxes is empty %}
            <p>Você ainda não tem caixas vinculadas à sua conta.</p>
        {% else %}
            <div class="table-container box g4-card">
                <table class="table is-fullwidth is-hoverable">
                    <thead><tr><th>Caixa de e-mail</th><th>Criada em</th><th>Recebe até</th><th>Ações</th></tr></thead>
                    <tbody>
                        {% for box in boxes %}
                            {% set link = path('app_client_inbox', {uuid: box.uuid}) %}
                            <tr>
                                <th scope="row">{{ box.email }}</th>
                                <td>{{ box.createdAt|date('d/m/Y') }}</td>
                                <td>{{ box.expiresAt ? box.expiresAt|date('d/m/Y') : '—' }}</td>
                                <td><a href="{{ link }}">Abrir caixa e gerenciar senha</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
