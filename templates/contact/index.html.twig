{% extends 'base.html.twig' %}

{% block title %}Contato - Mail4u{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-8">
                    <div class="box">
                        <h1 class="title has-text-centered">Contato</h1>
                        <p>
                            O Mail4u é um projeto de código aberto. Você pode entrar em contato pelo
                            <a href="https://github.com/jotavfagundes/Gerador4u" target="_blank" rel="noopener">GitHub</a>.
                        </p>

                        <h2 class="title is-4 mt-5">Sugestões de melhorias</h2>
                        <p>
                            Tem uma ideia para melhorar o Mail4u? Abra uma solicitação no
                            <a href="https://github.com/jotavfagundes/Gerador4u/issues" target="_blank" rel="noopener">GitHub</a>
                            e descreva sua sugestão.
                        </p>

                        <h2 class="title is-4 mt-5">Encontrou um problema?</h2>
                        <p>
                            Se algo não funcionar como esperado, abra uma solicitação no
                            <a href="https://github.com/jotavfagundes/Gerador4u/issues" target="_blank" rel="noopener">GitHub</a>.
                            Descreva o que você fez, o que esperava e o que aconteceu.
                        </p>

                        <h2 class="title is-4 mt-5">Contato pelo GitHub</h2>
                        <p>
                            Você pode entrar em contato pelo
                            <a href="https://github.com/jotavfagundes/Gerador4u" target="_blank" rel="noopener">GitHub</a>.
                            Abra uma solicitação ou inicie uma discussão no repositório.
                        </p>

                        <h2 class="title is-4 mt-5">Apoio</h2>
                        <p>
                            Você pode apoiar o desenvolvimento do projeto original pelo
                            <a href="https://ko-fi.com/galgaldas" target="_blank" rel="noopener">Ko-fi</a>.
                        </p>

                        <div class="buttons is-centered mt-5">
                            <a class="button is-dark" href="https://github.com/jotavfagundes/Gerador4u" target="_blank" rel="noopener">
                                <strong>Visitar o projeto no GitHub</strong>
                            </a>
                            <a class="button is-primary is-light" href="https://ko-fi.com/galgaldas" target="_blank" rel="noopener">
                                <strong>Apoiar no Ko-fi</strong>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
