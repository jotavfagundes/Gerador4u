{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block detail_fields %}
    {% set email = entity.instance %}
    <article class="mail4u-admin-panel mb-4" aria-label="Mensagem recebida">
        <header class="p-3 border-bottom">
            <h2 class="p-0 mb-2">{{ email.subject|default('(Sem assunto)') }}</h2>
            <div><strong>De</strong> {{ email.fromName ?: email.realFrom }}{% if email.fromName %} &lt;{{ email.fromAddress ?: email.realFrom }}&gt;{% endif %}</div>
            <div><strong>Para</strong> {{ email.realTo }}</div>
            {% if email.createdAt %}
                <time datetime="{{ email.createdAt|date('c', false) }}">{{ email.createdAt|date('d/m/Y H:i') }}</time>
            {% endif %}
            <div class="mt-3">
                {% if email.temporaryEmailBox and email.temporaryEmailBox.isClientInbox() %}
                    <a class="btn btn-outline-primary" href="{{ path('app_client_inbox', {uuid: email.temporaryEmailBox.uuid}) }}">Abrir caixa no Mail4u</a>
                {% elseif email.temporaryEmailBox is null %}
                    <form method="post" action="{{ path('admin_received_email_link_mailbox', {id: email.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('link-mailbox-' ~ email.id) }}">
                        <button class="btn btn-primary" type="submit">Criar ou vincular caixa no Mail4u</button>
                    </form>
                    <p class="mt-2 mb-0">Usa o endereço do destinatário e vincula esta mensagem à caixa.</p>
                {% endif %}
            </div>
        </header>
        {% include 'email_box/preview.html.twig' with {
            html: email.html,
            text: email.metadata.text ?? null,
            frameStyle: 'display: block; width: 100%; height: 60vh; min-height: 22rem; border: 0'
        } only %}
    </article>

    <details class="mb-3">
        <summary class="mb-3">Detalhes técnicos</summary>
        {{ parent() }}
    </details>
{% endblock %}
