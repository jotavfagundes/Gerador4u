{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block detail_fields %}
    {% set email = entity.instance %}
    <article class="mail4u-admin-panel mb-4" aria-label="Mensagem recebida">
        <header class="p-3 border-bottom">
            <h2 class="p-0 mb-2">{{ email.subject|default('(Sem assunto)') }}</h2>
            <div><strong>De</strong> {{ email.fromName ?: email.realFrom }}{% if email.fromName %} &lt;{{ email.fromAddress ?: email.realFrom }}&gt;{% endif %}</div>
            <div><strong>Para</strong> {{ email.realTo }}</div>
            {% if email.createdAt %}
                <time datetime="{{ email.createdAt|date('c', false) }}">{{ email.createdAt|date('d/m/Y H:i') }}</time>
            {% endif %}
        </header>
        {% include 'email_box/preview.html.twig' with {
            html: email.html,
            text: email.metadata.text ?? null,
            frameStyle: 'display: block; width: 100%; height: 60vh; min-height: 22rem; border: 0'
        } only %}
    </article>

    <details class="mb-3">
        <summary class="mb-3">Detalhes técnicos</summary>
        {{ parent() }}
    </details>
{% endblock %}
