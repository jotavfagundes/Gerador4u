{% extends "@EasyAdmin/page/content.html.twig" %}

{% block content_title %}Visão geral{% endblock %}

{% block main %}
    {% for message in app.flashes('notice') %}
        <div class="flash-notice">
            {{ message }}
        </div>
    {% endfor %}
    <section class="section mail4u-dashboard">
        <div class="mail4u-dashboard-content">
            <div class="mail4u-admin-hero">
                <div>
                    <h2>Operação do Mail4u</h2>
                    <p>Acompanhe os domínios, as caixas e o recebimento de mensagens.</p>
                </div>
                <span class="mail4u-admin-hero-icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
            </div>
            <div class="g4-stats">
                {% for label, value in {
                    'Domínios ativos': activeDomainsCount,
                    'Caixas cadastradas': temporaryEmailBoxCount,
                    'Mensagens recebidas': receivedEmailsWithEmailBoxCount + receivedEmailsWithoutEmailBoxCount,
                    'Mensagens não lidas': unreadEmails
                } %}
                    <div class="g4-card g4-stat"><i class="fas {{ ['fa-globe', 'fa-inbox', 'fa-envelope', 'fa-envelope-open'][loop.index0] }}" aria-hidden="true"></i><div><strong>{{ value }}</strong><span>{{ label }}</span></div></div>
                {% endfor %}
            </div>

            <section class="mail4u-admin-panel">
            <h2>Caixas recentes</h2>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>E-mail</th><th>Status</th><th>Recebe até</th></tr></thead>
                    <tbody>
                    {% for mailbox in recentMailboxes %}
                        <tr>
                            <td>{{ mailbox.email }}</td>
                            <td>
                                {% if mailbox.expiresAt is null %}
                                    <span class="badge text-bg-secondary">Sem prazo</span>
                                {% elseif mailbox.expiresAt > date() %}
                                    <span class="badge text-bg-success">Ativa</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Expirada</span>
                                {% endif %}
                            </td>
                            <td>{{ mailbox.expiresAt ? mailbox.expiresAt|date('d/m/Y') : '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3">Nenhuma caixa cadastrada.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            </section>

            {% if activeDomainsCount == 0 %}
                <div class="alert alert-danger" role="alert">
                    ⚠️ Nenhum domínio ativo. Cadastre um na seção Domínios do menu lateral.
                </div>
            {% endif %}


            <section class="mail4u-admin-panel">
            <h2>Atividade de recebimento</h2>
            <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    <th>Métrica</th>
                    <th>Total</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>Domínios ativos</td>
                    <td>{{ activeDomainsCount }}</td>
                </tr>
                <tr>
                    <td>Total de caixas temporárias</td>
                    <td>{{ temporaryEmailBoxCount }}</td>
                </tr>
                <tr>
                    <td>Total de e-mails recebidos com caixa vinculada</td>
                    <td>{{ receivedEmailsWithEmailBoxCount }}</td>
                </tr>
                <tr>
                    <td>Total de e-mails recebidos sem caixa vinculada</td>
                    <td>{{ receivedEmailsWithoutEmailBoxCount }}</td>
                </tr>
                <tr>
                    <td>E-mails lidos</td>
                    <td>{{ readEmails }}</td>
                </tr>
                <tr>
                    <td>E-mails não lidos</td>
                    <td>{{ unreadEmails }}</td>
                </tr>
                <tr>
                    <td>E-mails com assunto lido</td>
                    <td>{{ emailsWithReadSubjects }}</td>
                </tr>
                <tr>
                    <td>Primeiro e-mail recebido em</td>
                    <td>{{ oldestReceivedEmailAt ? oldestReceivedEmailAt.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                </tr>
                <tr>
                    <td>Último e-mail recebido em</td>
                    <td>{{ newestReceivedEmailAt ? newestReceivedEmailAt.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                </tr>
                </tbody>
            </table>
            </div>
            </section>

            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <section class="mail4u-admin-panel">
                    <h2 class="title">5 países com mais e-mails recebidos</h2>
                    <table class="table is-striped is-hoverable is-fullwidth">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>País</th>
                            <th>E-mails recebidos</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in topCountriesByReceivedEmails %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ row.countryCode }}</td>
                                <td>{{ row.receivedEmailCount }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3">Sem dados</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </section>
                </div>

                <div class="col-md-6 mb-3">
                    <section class="mail4u-admin-panel">
                    <h2 class="title">5 países com mais caixas criadas</h2>
                    <table class="table is-striped is-hoverable is-fullwidth">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>País</th>
                            <th>Caixas de entrada</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in topCountriesByEmailBoxes %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ row.countryCode }}</td>
                                <td>{{ row.emailBoxCount }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3">Sem dados</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </section>
                </div>
            </div>
        </div>
    </section>
{% endblock main %}
